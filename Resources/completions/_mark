#compdef mark
#
# Completion for Markpad's `mark` command.
#
# zsh ships `_mh`, the completion for the MH mail system, and MH has a `mark`
# command of its own for managing message sequences. It claims the name, so
# without this file `mark <tab>` offers mail folders instead of filenames.

_arguments -s -S \
    '(- *)'{-h,--help}'[show usage]' \
    '*:file:_files'
